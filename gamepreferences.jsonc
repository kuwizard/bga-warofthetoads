{
  // user preferences ids should be between 100 and 199
  // See https://en.doc.boardgamearena.com/Options_and_preferences:_gameoptions.json,_gamepreferences.json for more details

  // Drives the --am CSS custom property (src/scss/Game.scss) and the client's
  // animDur() helper. No cssPref — Game.ts applies the multiplier itself via JS
  // so it can also update the bga-cards animation manager (PR8).
  "100": {
    "name": "Animation speed",
    "needReload": false,
    "values": {
      "1": { "name": "Slow" },
      "2": { "name": "Normal" },
      "3": { "name": "Fast" },
      "4": { "name": "Very fast" }
    },
    "default": 2
  },

  // 101 is reserved for the card-counting aid toggle (PR9) — default off, shows
  // which of the 9 card types have been seen this War.

  // Read via layout.ts::BOARD_LAYOUT_PREF_ID. "Top and bottom" is the default:
  // the two players face each other, each playing their open card to the left
  // and their hidden one to the right, with the Shrine turned a quarter turn to
  // the right of the lanes. Which end is yours follows preference 103.
  "102": {
    "name": "Player blocks position",
    "needReload": false,
    "values": {
      "1": { "name": "Left and right" },
      "2": { "name": "Top and bottom" }
    },
    "default": 2
  },

  // Read via hand.ts::HAND_POSITION_PREF_ID.
  "103": {
    "name": "Hand position",
    "needReload": false,
    "values": {
      "1": { "name": "Top" },
      "2": { "name": "Bottom" }
    },
    "default": 1
  },

  // Read via layout.ts::OPPONENT_HAND_PREF_ID — the row of card backs
  // (src/ts/opponentHand.ts) that sits at whichever end preference 103 leaves
  // free. Hiding it only takes the row off screen: cards then fly out of that
  // player's deck instead, and the count is still kept up to date underneath.
  "104": {
    "name": "Opponent's hand",
    "needReload": false,
    "values": {
      "1": { "name": "Show" },
      "2": { "name": "Hide" }
    },
    "default": 1
  }
}