# Dependencies
node_modules/

# IDE / editor local config (machine-specific; holds SFTP server settings)
.idea/
.vscode/
.claude/settings.local.json

# BGA Studio scaffold reference — never modified, never tracked
bga_initial_code_template/

# Images: large binaries, deployed to BGA via SFTP separately
img/

# Publisher source material — print-resolution PDFs, rulebooks, art masters.
# Hundreds of MB, never deployed; sprite sheets are derived from it into img/.
Raw/

# Working documentation — rules transcriptions, implementation plans, author
# questions, assumptions. Local reference only; never tracked, never deployed.
doc/

# Generated source maps
*.css.map
*.js.map

# Stray CSS compiled next to the SCSS sources — the watcher must output
# warofthetoads.css in the project root instead (see README, IDE file watcher)
src/scss/*.css

.DS_Store
