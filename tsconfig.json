{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rootDir": "src/ts",
    "outDir": "modules/js",
    "removeComments": true,
    "strict": false,
    "sourceMap": false,
    "lib": ["DOM", "ESNext"]
  },
  "include": [
    "*.d.ts",
    "src/ts/**/*.d.ts",
    "src/ts/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
